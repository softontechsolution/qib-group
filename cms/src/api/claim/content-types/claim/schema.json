{
  "kind": "collectionType",
  "collectionName": "claims",
  "info": {
    "singularName": "claim",
    "pluralName": "claims",
    "displayName": "Claim"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "email": {
      "type": "string"
    },
    "policyNumber": {
      "type": "string"
    },
    "coverType": {
      "type": "enumeration",
      "enum": [
        "Comprehensive",
        "Third Party Only",
        "Third Party Fire & Theft"
      ]
    },
    "claimStatus": {
      "type": "enumeration",
      "default": "pending",
      "enum": [
        "pending",
        "processing",
        "approved",
        "declined"
      ]
    },
    "claimForm": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "evidence": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
